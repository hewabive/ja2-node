      "font": "AIM_FI_HELP_TITLE_FONT",
      "color": "AIM_FONT_MCOLOR_WHITE",
      "shadow": "DEFAULT_SHADOW",
      "text": {
        "key": ["AimFiText", "AIM_FI_LEFT_CLICK"]
      },
      "width": "AIM_FI_CLICK_TEXT_WIDTH",
      "align": "center"
    },
    {
      "type": "text",
      "x": "AIM_FI_LEFT_CLICK_TEXT_X",
      "y": "AIM_FI_LEFT_CLICK_TEXT_Y + AIM_FI_CLICK_DESC_TEXT_Y_OFFSET",
      "font": "AIM_FI_HELP_FONT",
      "color": "AIM_FONT_MCOLOR_WHITE",
      "shadow": "DEFAULT_SHADOW",
      "text": {
