          "x": 0,
          "y": 0,
          "width": "AIM_FI_PORTRAIT_WIDTH",
          "height": "AIM_FI_PORTRAIT_HEIGHT",
          "priority": "HIGH",
          "cursor": "CURSOR_WWW",
          "primary": "selectFace(2,$i)",
          "secondary": "sortPage",
          "hover": "hoverFace(2,$i)"
        }
