    {
      "type": "repeat",
      "count": "AIM_FI_NUM_MUHSHOTS_X",
      "x": "AIM_FI_FIRST_MUGSHOT_X",
      "y": "AIM_FI_FIRST_MUGSHOT_Y + (AIM_FI_PORTRAIT_HEIGHT + AIM_FI_MUGSHOT_GAP_Y) * 4",
      "dx": "AIM_FI_PORTRAIT_WIDTH + AIM_FI_MUGSHOT_GAP_X",
      "template": [
        {
          "type": "image",
          "asset": "border",
          "frame": {
            "bind": "mugRows[4][$i].border"
          },
          "x": 0,
          "y": 0,
          "visible": "mugRows[4][$i].present"
        },
        {
          "type": "portrait",
          "id": "mugShot4_$i",
          "face": {
            "bind": "mugRows[4][$i].face"
          },
