    },
    {
      "type": "repeat",
      "count": "AIM_FI_NUM_MUHSHOTS_X",
      "x": "AIM_FI_FIRST_MUGSHOT_X",
      "y": "AIM_FI_FIRST_MUGSHOT_Y + (AIM_FI_PORTRAIT_HEIGHT + AIM_FI_MUGSHOT_GAP_Y) * 3",
      "dx": "AIM_FI_PORTRAIT_WIDTH + AIM_FI_MUGSHOT_GAP_X",
      "template": [
        {
          "type": "image",
          "asset": "border",
          "frame": {
