          "font": "AIM_FONT12ARIAL",
          "color": "AIM_FONT_MCOLOR_WHITE",
          "shadow": "DEFAULT_SHADOW",
          "text": {
            "bind": "mugRows[2][$i].nickname"
          },
          "id": "mugName2_$i",
          "width": "AIM_FI_NNAME_WIDTH",
          "align": "center"
        },
        {
          "type": "text",
          "x": "AIM_FI_AWAY_TEXT_OFFSET_X",
          "y": "AIM_FI_AWAY_TEXT_OFFSET_Y",
          "font": "FONT10ARIAL",
          "color": 145,
          "shadow": "DEFAULT_SHADOW",
          "text": {
            "bind": "mugRows[2][$i].overlay"
          },
          "width": "AIM_FI_AWAY_TEXT_OFFSET_WIDTH",
