{
  "@derived": "Jagged Alliance 2 source code (SFI-SCLA) via JA2 Stracciatella",
  "@src": [
    "src/game/Laptop/History.cc RenderHistoryBackGround (historywindow.sti at TOP_X, TOP_Y + 22), DisplayHistoryListBackground (historylines.sti 11 times at TOP_X + 15, TOP_DIVLINE_Y + BOX_HEIGHT * 2 * i; divisionline480.sti at TOP_X + 9 on TOP_DIVLINE_Y and TOP_DIVLINE_Y + BOX_HEIGHT * 2 * 11), DisplayHistoryListHeaders (pHistoryHeaders 0, 3 and 4 centred over RECORD_DATE_WIDTH, RECORD_LOCATION_WIDTH and 471 - both, from RECORD_DATE_X + 5), DrawHistoryRecordsText (rows at RECORD_Y + i * BOX_HEIGHT + 3: the day centred in RECORD_DATE_WIDTH at RECORD_DATE_X + 5, the location, the text at RECORD_DATE_X + RECORD_LOCATION_WIDTH + RECORD_DATE_WIDTH + 15; HISTORY_TEXT_FONT, no shadow), DisplayPageNumberAndDateRange (PAGE_NUMBER_X/Y, HISTORY_DATE_X/Y), CreateHistoryButtons (arrows.sti 0/1 at PREV_BTN_X and 6/7 at NEXT_BTN_X on BTN_Y, MSYS_PRIORITY_HIGHEST - 1, CURSOR_LAPTOP_SCREEN; the wheel region TOP_X + 8, TOP_Y + 53 to + 482, + 354 at MSYS_PRIORITY_HIGH)"
  ],
  "screen": "laptopHistory",
  "frame": "std640",
  "constants": ["Laptop", "History"],
  "assets": {
    "window": {
      "sti": "laptop/historywindow.sti",
      "stub": {
        "frames": 1,
        "size": ["LAPTOP_SCREEN_WIDTH", "LAPTOP_SCREEN_HEIGHT - 22"],
        "style": "hollow"
      }
    },
    "shadeLine": {
      "sti": "laptop/historylines.sti",
      "stub": {
        "frames": 1,
        "size": [471, "BOX_HEIGHT"],
        "style": "hollow"
      }
    },
    "longLine": {
      "sti": "laptop/divisionline480.sti",
      "stub": {
        "frames": 1,
        "size": [480, 2]
      }
    },
    "arrows": {
      "sti": "laptop/arrows.sti",
      "stub": {
        "frames": 11,
        "size": [22, 16],
        "states": ["normal", "pressed", "plain", "normal", "pressed", "plain", "normal", "pressed", "plain", "normal", "pressed"]
      }
    }
  },
  "widgets": [
    {
      "type": "image",
      "asset": "window",
      "frame": 0,
      "x": "TOP_X",
      "y": "TOP_Y + 22"
    },
    {
      "type": "repeat",
      "count": 11,
      "x": "TOP_X + 15",
      "y": "TOP_DIVLINE_Y",
      "dy": "BOX_HEIGHT * 2",
      "template": [
        {
          "type": "image",
          "asset": "shadeLine",
          "frame": 0,
          "x": 0,
          "y": 0
        }
      ]
    },
    {
      "type": "image",
      "asset": "longLine",
      "frame": 0,
      "x": "TOP_X + 9",
      "y": "TOP_DIVLINE_Y"
    },
    {
      "type": "image",
      "asset": "longLine",
      "frame": 0,
      "x": "TOP_X + 9",
      "y": "TOP_DIVLINE_Y + BOX_HEIGHT * 2 * 11"
    },
    {
      "type": "text",
      "x": "RECORD_DATE_X + 5",
      "y": "RECORD_HEADER_Y",
      "width": "RECORD_DATE_WIDTH",
      "align": "center",
      "alignRule": "font",
      "font": "HISTORY_TEXT_FONT",
      "color": "FONT_BLACK",
      "shadow": "NO_SHADOW",
      "text": {
        "key": ["pHistoryHeaders", 0]
      }
    },
    {
      "type": "text",
      "x": "RECORD_DATE_X + 5 + RECORD_DATE_WIDTH",
      "y": "RECORD_HEADER_Y",
      "width": "RECORD_LOCATION_WIDTH",
      "align": "center",
      "alignRule": "font",
      "font": "HISTORY_TEXT_FONT",
      "color": "FONT_BLACK",
      "shadow": "NO_SHADOW",
      "text": {
        "key": ["pHistoryHeaders", 3]
      }
    },
    {
      "type": "text",
      "x": "RECORD_DATE_X + 5 + RECORD_DATE_WIDTH + RECORD_LOCATION_WIDTH",
      "y": "RECORD_HEADER_Y",
      "width": "471 - RECORD_DATE_WIDTH - RECORD_LOCATION_WIDTH",
      "align": "center",
      "alignRule": "font",
      "font": "HISTORY_TEXT_FONT",
      "color": "FONT_BLACK",
      "shadow": "NO_SHADOW",
      "text": {
        "key": ["pHistoryHeaders", 4]
      }
    },
    {
      "type": "repeat",
      "count": "NUM_RECORDS_PER_PAGE",
      "x": 0,
      "y": "RECORD_Y + 3",
      "dy": "BOX_HEIGHT",
      "template": [
        {
          "type": "text",
          "id": "historyDate$i",
          "x": "RECORD_DATE_X + 5",
          "y": 0,
          "width": "RECORD_DATE_WIDTH",
          "align": "center",
          "alignRule": "font",
          "font": "HISTORY_TEXT_FONT",
          "color": {
            "by": "rows[$i].colour",
            "map": {
              "black": "FONT_BLACK",
              "red": "FONT_RED"
            }
          },
          "shadow": "NO_SHADOW",
          "text": {
            "bind": "rows[$i].date"
          },
          "visible": "rows[$i].present"
        },
        {
          "type": "text",
          "id": "historyLocation$i",
          "x": {
            "bind": "rows[$i].locationX"
          },
          "y": 0,
          "font": "HISTORY_TEXT_FONT",
          "color": {
            "by": "rows[$i].colour",
            "map": {
              "black": "FONT_BLACK",
              "red": "FONT_RED"
            }
          },
          "shadow": "NO_SHADOW",
          "text": {
            "bind": "rows[$i].location"
          },
          "visible": "rows[$i].present"
        },
        {
          "type": "text",
          "id": "historyText$i",
          "x": "RECORD_DATE_X + RECORD_LOCATION_WIDTH + RECORD_DATE_WIDTH + 15",
          "y": 0,
          "font": "HISTORY_TEXT_FONT",
          "color": {
            "by": "rows[$i].colour",
            "map": {
              "black": "FONT_BLACK",
              "red": "FONT_RED"
            }
          },
          "shadow": "NO_SHADOW",
          "text": {
            "bind": "rows[$i].text"
          },
          "visible": "rows[$i].present"
        }
      ]
    },
    {
      "type": "text",
      "id": "historyPage",
      "x": "PAGE_NUMBER_X",
      "y": "PAGE_NUMBER_Y",
      "font": "HISTORY_TEXT_FONT",
      "color": "FONT_BLACK",
      "shadow": "NO_SHADOW",
      "text": {
        "bind": "pageText"
      }
    },
    {
      "type": "text",
      "id": "historyDays",
      "x": "HISTORY_DATE_X",
      "y": "HISTORY_DATE_Y",
      "font": "HISTORY_TEXT_FONT",
      "color": "FONT_BLACK",
      "shadow": "NO_SHADOW",
      "text": {
        "bind": "dateText"
      }
    },
    {
      "type": "button",
      "id": "prevHistoryPage",
      "x": "PREV_BTN_X",
      "y": "BTN_Y",
      "asset": "arrows",
      "frames": {
        "offNormal": 0,
        "onNormal": 1
      },
      "priority": "HIGHEST-1",
      "cursor": "CURSOR_LAPTOP_SCREEN",
      "enabled": "prevEnabled",
      "primary": "prevPage"
    },
    {
      "type": "button",
      "id": "nextHistoryPage",
      "x": "NEXT_BTN_X",
      "y": "BTN_Y",
      "asset": "arrows",
      "frames": {
        "offNormal": 6,
        "onNormal": 7
      },
      "priority": "HIGHEST-1",
      "cursor": "CURSOR_LAPTOP_SCREEN",
      "enabled": "nextEnabled",
      "primary": "nextPage"
    },
    {
      "type": "region",
      "id": "historyScroll",
      "x": "TOP_X + 8",
      "y": "TOP_Y + 53",
      "width": 482,
      "height": 354,
      "priority": "HIGH",
      "wheelUp": "prevPage",
      "wheelDown": "nextPage"
    }
  ]
}
