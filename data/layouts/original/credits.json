{
  "@derived": "Jagged Alliance 2 source code (SFI-SCLA) via JA2 Stracciatella",
  "@src": [
    "src/game/Credits.cc EnterCreditsScreen (the background region, the face regions at MSYS_PRIORITY_HIGHEST with CURSOR_WWW), gCreditFaces (the face rectangles and eye positions), RenderCreditScreen (interface/credits.sti), HandleCreditScreen (the name, title and joke of the hovered face centred in CRDT_NAME_LOC_WIDTH at CRDT_NAME_LOC_X), AddCreditNode and DisplayCreditNode (the text column at CRDT_TEXT_START_LOC, CRDT_WIDTH_OF_TEXT_AREA wide, wrapped with a gap of 2, drawn one pixel into its node), HandleCreditEyeBlinking (interface/credit faces.sti frame 3 · i at the eye position, CRDT_EYE_WIDTH × CRDT_EYE_HEIGHT), GetCreditScreenUserInput (Escape on KEY_UP)"
  ],
  "screen": "credits",
  "frame": "std640",
  "constants": ["Credits"],
  "assets": {
    "background": {
      "sti": "interface/credits.sti",
      "stub": {
        "size": [640, 480]
      }
    },
    "faces": {
      "sti": "interface/credit faces.sti",
      "stub": {
        "frames": 45,
        "size": ["CRDT_EYE_WIDTH", "CRDT_EYE_HEIGHT"]
      }
    }
  },
  "styles": {
