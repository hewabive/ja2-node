{
  "@derived": "Jagged Alliance 2 source code (SFI-SCLA) via JA2 Stracciatella",
  "@src": [
    "src/game/Tactical/ShopKeeper_Interface.cc EnterShopKeeperInterface (tradescrollarrows.sti 0/1 and 2/3 at SKI_PAGE_UP_ARROWS_X/Y and SKI_PAGE_DOWN_ARROWS_X/Y at MSYS_PRIORITY_HIGHEST, hatched when disabled; tradebuttons.sti 0/1 for Transaction at MSYS_PRIORITY_HIGH and Done at MSYS_PRIORITY_HIGH + 10 with SKI_BUTTON_FONT in SKI_BUTTON_COLOR, DEFAULT_SHADOW, hatched when disabled, the repairman's transaction help; the region over the screen down to INV_INTERFACE_START_Y at MSYS_PRIORITY_HIGH - 2; the dealer's face region at MSYS_PRIORITY_HIGH - 1), MakeButton, CreateSkiInventorySlotMouseRegions (the wheel region 161, 27 to 532, 137; the 5 \u00d7 3 dealer slots, the 6 \u00d7 2 offer slots at SKI_INV_OFFSET_X/Y, SKI_INV_SLOT_WIDTH \u00d7 SKI_INV_SLOT_HEIGHT, MSYS_PRIORITY_HIGH), RenderShopKeeperInterface (tradescreen.sti, the title with DrawTextToScreen centred in SKI_MAIN_TITLE_WIDTH, the cost, value and balance labels with DisplayWrappedString centred in 73 with a 2-pixel gap, the balance in FONT10ARIAL at SKI_PLAYERS_CURRENT_BALANCE_OFFSET_TO_VALUE), DisplayArmsDealerOfferArea and DisplayPlayersOfferArea (the totals in SKI_LABEL_FONT centred in SKI_INV_SLOT_WIDTH 5 pixels below SKI_ARMS_DEALER_TOTAL_COST_Y and SKI_PLAYERS_TOTAL_VALUE_Y)"
  ],
  "screen": "shop",
  "frame": "std640",
  "tooltips": true,
  "constants": ["ShopKeeper_Interface", "Text", "UILayout"],
  "assets": {
    "background": {
      "sti": "interface/tradescreen.sti",
      "stub": {
        "size": ["SKI_TACTICAL_BACKGROUND_START_X", "SKI_TACTICAL_BACKGROUND_START_HEIGHT"]
      }
    },
    "arrows": {
      "sti": "interface/tradescrollarrows.sti",
      "stub": {
        "sizes": [[30, 22], [30, 22], [30, 22], [30, 22]],
        "states": ["normal", "pressed", "normal", "pressed"]
      }
    },
    "buttons": {
      "sti": "interface/tradebuttons.sti",
      "stub": {
        "sizes": [[128, 24], [128, 24]],
        "states": ["normal", "pressed"]
      }
    },
    "crossOut": {
      "sti": "interface/itemcrossout.sti",
      "stub": {
        "style": "hollow",
        "size": [24, 24]
      }
    }
  },
  "widgets": [
    {
      "type": "region",
      "id": "shopScreen",
      "within": "screen",
      "x": 0,
      "y": 0,
      "width": "$screenWidth",
      "height": "$screenHeight - INV_INTERFACE_HEIGHT",
      "priority": "HIGH-2",
      "cursor": "CURSOR_NORMAL"
    },
    {
      "type": "image",
      "id": "shopBackground",
      "x": "SKI_MAIN_BACKGROUND_X",
      "y": "SKI_MAIN_BACKGROUND_Y",
      "asset": "background",
      "frame": 0
    },
    {
      "type": "text",
      "id": "shopTitle",
      "x": "SKI_MAIN_TITLE_X",
      "y": "SKI_MAIN_TITLE_Y",
      "width": "SKI_MAIN_TITLE_WIDTH",
      "font": "SKI_TITLE_FONT",
      "color": "SKI_TITLE_COLOR",
      "shadow": "DEFAULT_SHADOW",
      "align": "center",
      "text": {
        "key": ["SKI_Text", "SKI_TEXT_MERCHADISE_IN_STOCK"]
      }
    },
    {
      "type": "text",
      "id": "shopCostLabel",
      "x": "SKI_TOTAL_COST_X",
      "y": "SKI_TOTAL_COST_Y",
      "width": "SKI_TOTAL_COST_WIDTH",
      "font": "SKI_LABEL_FONT",
      "color": "SKI_TITLE_COLOR",
      "shadow": "DEFAULT_SHADOW",
      "align": "center",
      "wrap": {
        "gap": 2
      },
      "text": {
        "key": ["SKI_Text", "SKI_TEXT_TOTAL_COST"]
      },
      "visible": {
        "eq": ["costLabel", "cost"]
      }
    },
    {
      "type": "text",
      "id": "shopRepairCostLabel",
      "x": "SKI_TOTAL_COST_X",
      "y": "SKI_TOTAL_COST_Y",
      "width": "SKI_TOTAL_COST_WIDTH",
      "font": "SKI_LABEL_FONT",
      "color": "SKI_TITLE_COLOR",
      "shadow": "DEFAULT_SHADOW",
      "align": "center",
      "wrap": {
        "gap": 2
      },
      "text": {
        "key": ["SKI_Text", "SKI_TEXT_REPAIR_COST"]
      },
      "visible": {
        "eq": ["costLabel", "repair"]
      }
    },
    {
      "type": "text",
      "id": "shopValueLabel",
      "x": "SKI_TOTAL_VALUE_X",
      "y": "SKI_TOTAL_VALUE_Y",
      "width": "SKI_TOTAL_VALUE_WIDTH",
      "font": "SKI_LABEL_FONT",
      "color": "SKI_TITLE_COLOR",
      "shadow": "DEFAULT_SHADOW",
      "align": "center",
      "wrap": {
        "gap": 2
      },
      "text": {
        "key": ["SKI_Text", "SKI_TEXT_TOTAL_VALUE"]
      }
    },
    {
      "type": "text",
      "id": "shopBalanceLabel",
      "x": "SKI_PLAYERS_CURRENT_BALANCE_X",
      "y": "SKI_PLAYERS_CURRENT_BALANCE_Y",
      "width": "SKI_PLAYERS_CURRENT_BALANCE_WIDTH",
      "font": "SKI_LABEL_FONT",
      "color": "SKI_TITLE_COLOR",
      "shadow": "DEFAULT_SHADOW",
      "align": "center",
      "wrap": {
        "gap": 2
      },
      "text": {
        "key": ["SkiMessageBoxText", "SKI_PLAYERS_CURRENT_BALANCE"]
      }
    },
    {
      "type": "text",
      "id": "shopBalance",
      "x": "SKI_PLAYERS_CURRENT_BALANCE_X",
      "y": "SKI_PLAYERS_CURRENT_BALANCE_OFFSET_TO_VALUE",
      "width": "SKI_PLAYERS_CURRENT_BALANCE_WIDTH",
      "font": "FONT10ARIAL",
      "color": "SKI_ITEM_PRICE_COLOR",
      "shadow": "DEFAULT_SHADOW",
      "align": "center",
      "text": {
        "money": {
          "bind": "balance"
        }
      }
    },
    {
      "type": "custom",
      "id": "shopPage",
      "renderer": "shopPage",
      "x": "SKI_PAGE_X",
      "y": "SKI_PAGE_Y",
      "width": "SKI_PAGE_WIDTH",
      "height": "SKI_PAGE_HEIGHT",
      "params": {
        "font": "SKI_LABEL_FONT",
        "color": "SKI_TITLE_COLOR",
        "labelOffset": 3,
        "numberGap": 6
      }
    },
    {
      "type": "custom",
      "id": "shopFace",
      "renderer": "shopFace",
      "x": "SKI_FACE_X",
      "y": "SKI_FACE_Y",
      "width": "SKI_FACE_WIDTH",
      "height": "SKI_FACE_HEIGHT"
    },
    {
      "type": "custom",
      "id": "shopDealerGrid",
      "renderer": "shopSlots",
      "x": "SKI_ARMS_DEALERS_INV_START_X",
      "y": "SKI_ARMS_DEALERS_INV_START_Y",
      "width": 0,
      "height": 0,
      "params": {
        "area": "dealer",
        "slots": "SKI_NUM_ARMS_DEALERS_INV_SLOTS",
        "columns": "SKI_NUM_ARMS_DEALERS_INV_COLS"
      }
    },
    {
      "type": "custom",
      "id": "shopDealerOffer",
      "renderer": "shopSlots",
      "x": "SKI_ARMS_DEALERS_TRADING_INV_X",
      "y": "SKI_ARMS_DEALERS_TRADING_INV_Y",
      "width": 0,
      "height": 0,
      "params": {
        "area": "dealerOffer",
        "slots": "SKI_NUM_TRADING_INV_SLOTS",
        "columns": "SKI_NUM_TRADING_INV_COLS"
      }
    },
    {
      "type": "custom",
      "id": "shopPlayerOffer",
      "renderer": "shopSlots",
      "x": "SKI_PLAYERS_TRADING_INV_X",
      "y": "SKI_PLAYERS_TRADING_INV_Y",
      "width": 0,
      "height": 0,
      "params": {
        "area": "playerOffer",
        "slots": "SKI_NUM_TRADING_INV_SLOTS",
        "columns": "SKI_NUM_TRADING_INV_COLS",
        "crossOut": "crossOut"
      }
    },
    {
      "type": "text",
      "id": "shopTotalCost",
      "x": "SKI_ARMS_DEALER_TOTAL_COST_X",
      "y": "SKI_ARMS_DEALER_TOTAL_COST_Y + 5",
      "width": "SKI_INV_SLOT_WIDTH",
      "font": "SKI_LABEL_FONT",
      "color": "SKI_ITEM_PRICE_COLOR",
      "shadow": "DEFAULT_SHADOW",
      "align": "center",
      "text": {
        "money": {
          "bind": "totalCost"
        }
      }
    },
    {
      "type": "text",
      "id": "shopTotalValue",
      "x": "SKI_PLAYERS_TOTAL_VALUE_X",
      "y": "SKI_PLAYERS_TOTAL_VALUE_Y + 5",
      "width": "SKI_INV_SLOT_WIDTH",
      "font": "SKI_LABEL_FONT",
      "color": "SKI_ITEM_PRICE_COLOR",
      "shadow": "DEFAULT_SHADOW",
      "align": "center",
      "text": {
        "money": {
          "bind": "totalValue"
        }
      }
    },
    {
      "type": "custom",
      "id": "shopSubtitle",
      "renderer": "shopSubtitle",
      "x": "SKI_FACE_X",
      "y": "SKI_POSITION_SUBTITLES_Y",
      "width": 300,
      "height": 0
    },
    {
      "type": "region",
      "id": "shopWheel",
      "x": 161,
      "y": 27,
      "width": 371,
      "height": 110,
      "priority": "HIGH",
      "cursor": "CURSOR_NORMAL",
      "wheelUp": "pageUp",
      "wheelDown": "pageDown"
    },
    {
      "type": "region",
      "id": "shopFaceRegion",
      "x": "SKI_FACE_X",
      "y": "SKI_FACE_Y",
      "width": "SKI_FACE_WIDTH",
      "height": "SKI_FACE_HEIGHT",
      "priority": "HIGH-1",
      "cursor": "CURSOR_NORMAL",
      "primary": "shutUp",
      "secondary": "shutUp"
    },
    {
      "type": "repeat",
      "count": "SKI_NUM_ARMS_DEALERS_INV_SLOTS",
      "template": [
        {
          "type": "region",
          "id": "shopDealerSlot$i",
          "x": "SKI_ARMS_DEALERS_INV_START_X + $i % SKI_NUM_ARMS_DEALERS_INV_COLS * SKI_INV_OFFSET_X",
          "y": "SKI_ARMS_DEALERS_INV_START_Y + $i / SKI_NUM_ARMS_DEALERS_INV_COLS * SKI_INV_OFFSET_Y",
          "width": "SKI_INV_SLOT_WIDTH",
          "height": "SKI_INV_SLOT_HEIGHT",
          "priority": "HIGH",
          "cursor": "CURSOR_NORMAL",
          "enabled": "dealerSlotsEnabled",
          "tooltip": {
            "bind": "dealerTips[$i]"
          },
          "primary": "dealerPrimary($i)",
          "secondary": "dealerSecondary($i)",
          "hover": "dealerHover($i)",
          "wheelUp": "pageUp",
          "wheelDown": "pageDown"
        }
      ]
    },
    {
      "type": "repeat",
      "count": "SKI_NUM_TRADING_INV_SLOTS",
      "template": [
        {
          "type": "region",
          "id": "shopDealerOfferSlot$i",
          "x": "SKI_ARMS_DEALERS_TRADING_INV_X + $i % SKI_NUM_TRADING_INV_COLS * SKI_INV_OFFSET_X",
          "y": "SKI_ARMS_DEALERS_TRADING_INV_Y + $i / SKI_NUM_TRADING_INV_COLS * SKI_INV_OFFSET_Y",
          "width": "SKI_INV_SLOT_WIDTH",
          "height": "SKI_INV_SLOT_HEIGHT",
          "priority": "HIGH",
          "cursor": "CURSOR_NORMAL",
          "enabled": "dealerOfferEnabled",
          "tooltip": {
            "bind": "dealerOfferTips[$i]"
          },
          "primary": "dealerOfferPrimary($i)",
          "secondary": "dealerOfferSecondary($i)",
          "hover": "dealerOfferHover($i)"
        }
      ]
    },
    {
      "type": "repeat",
      "count": "SKI_NUM_TRADING_INV_SLOTS",
      "template": [
        {
          "type": "region",
          "id": "shopPlayerOfferSlot$i",
          "x": "SKI_PLAYERS_TRADING_INV_X + $i % SKI_NUM_TRADING_INV_COLS * SKI_INV_OFFSET_X",
          "y": "SKI_PLAYERS_TRADING_INV_Y + $i / SKI_NUM_TRADING_INV_COLS * SKI_INV_OFFSET_Y",
          "width": "SKI_INV_SLOT_WIDTH",
          "height": "SKI_INV_SLOT_HEIGHT",
          "priority": "HIGH",
          "cursor": "CURSOR_NORMAL",
          "enabled": "playerOfferEnabled",
          "tooltip": {
            "bind": "playerOfferTips[$i]"
          },
          "primary": "playerOfferPrimary($i)",
          "secondary": "playerOfferSecondary($i)",
          "hover": "playerOfferHover($i)"
        }
      ]
    },
    {
      "type": "button",
      "id": "shopPageUp",
      "x": "SKI_PAGE_UP_ARROWS_X",
      "y": "SKI_PAGE_UP_ARROWS_Y",
      "asset": "arrows",
      "frames": {
        "offNormal": 0,
        "onNormal": 1
      },
      "priority": "HIGHEST",
      "disabledStyle": "hatched",
      "enabled": "pageUpEnabled",
      "primary": "pageUp"
    },
    {
      "type": "button",
      "id": "shopPageDown",
      "x": "SKI_PAGE_DOWN_ARROWS_X",
      "y": "SKI_PAGE_DOWN_ARROWS_Y",
      "asset": "arrows",
      "frames": {
        "offNormal": 2,
        "onNormal": 3
      },
      "priority": "HIGHEST",
      "disabledStyle": "hatched",
      "enabled": "pageDownEnabled",
      "primary": "pageDown"
    },
    {
      "type": "button",
      "id": "shopTransaction",
      "x": "SKI_TRANSACTION_BUTTON_X",
      "y": "SKI_BUTTON_Y",
      "asset": "buttons",
      "frames": {
        "offNormal": 0,
        "onNormal": 1
      },
      "priority": "HIGH",
      "disabledStyle": "hatched",
      "enabled": "transactionEnabled",
      "primary": "transaction",
      "tooltip": {
        "bind": "transactionTip"
      },
      "text": {
        "source": {
          "key": ["SKI_Text", "SKI_TEXT_TRANSACTION"]
        },
        "font": "SKI_BUTTON_FONT",
        "color": "SKI_BUTTON_COLOR",
        "shadow": "DEFAULT_SHADOW",
        "downColor": "SKI_BUTTON_COLOR",
        "downShadow": "DEFAULT_SHADOW"
      }
    },
    {
      "type": "button",
      "id": "shopDone",
      "x": "SKI_DONE_BUTTON_X",
      "y": "SKI_BUTTON_Y",
      "asset": "buttons",
      "frames": {
        "offNormal": 0,
        "onNormal": 1
      },
      "priority": "HIGH+10",
      "disabledStyle": "hatched",
      "enabled": "doneEnabled",
      "primary": "done",
      "tooltip": {
        "key": ["SkiMessageBoxText", "SKI_DONE_BUTTON_HELP_TEXT"]
      },
      "text": {
        "source": {
          "key": ["SKI_Text", "SKI_TEXT_DONE"]
        },
        "font": "SKI_BUTTON_FONT",
        "color": "SKI_BUTTON_COLOR",
        "shadow": "DEFAULT_SHADOW",
        "downColor": "SKI_BUTTON_COLOR",
        "downShadow": "DEFAULT_SHADOW"
      }
    }
  ]
}
