{
  "@derived": "Jagged Alliance 2 source code (SFI-SCLA) via JA2 Stracciatella",
  "@src": [
    "src/game/Laptop/Insurance_Contract.cc EnterInsuranceContract (insordergrid.sti, the two bottom link regions from INS_CTRCT_BOTTON_LINK_RED_BAR_Y - 37 to INS_CTRCT_BOTTON_LINK_RED_BAR_Y + 2, INS_CTRCT_BOTTOM_LINK_RED_BAR_OFFSET apart; insleftbutton.sti and insrightbutton.sti with InsContractText PREVIOUS and NEXT, text offsets 17 or 18 and 16), RenderInsuranceContract (the link lines and texts, the title, the two bulleted instructions, the red line, up to three order grids), DisplayOrderGrid (the small portrait at +5, +4 shaded red when dead, the nickname, the status text in INS_FONT_SMALL wrapped in INS_CTRCT_CONTRACT_STATUS_TEXT_WIDTH, the employment and insurance contract rows, the premium right-aligned at +32, +179 over 72 pixels), CreateDestroyInsuranceContractFormButtons (acceptclearbox.sti 0/1 with InsContractText ACCEPT in INS_FONT_MED, INS_FONT_BTN_COLOR, INS_FONT_BTN_SHADOW_COLOR at INS_CTRCT_ACCEPT_BTN_X, INS_CTRCT_ACCEPT_BTN_Y of each grid, MSYS_PRIORITY_HIGH, CURSOR_LAPTOP_SCREEN), EnableDisableInsuranceContractAcceptButtons, DisableInsuranceContractNextPreviousbuttons, SelectInsuranceContractRegionCallBack (home, info)"
  ],
