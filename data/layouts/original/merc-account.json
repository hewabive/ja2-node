      "align": "center"
    },
    {
      "type": "text",
      "x": "MERC_AC_THIRD_COLUMN_X",
      "y": "MERC_AC_TOTAL_COST_Y",
      "width": "MERC_AC_THIRD_COLUMN_WIDTH",
      "font": "MERC_ACCOUNT_TEXT_FONT",
      "color": "MERC_ACCOUNT_TEXT_COLOR",
      "shadow": "DEFAULT_SHADOW",
      "background": "FONT_MCOLOR_BLACK",
      "text": {
        "key": ["MercAccountText", "MERC_ACCOUNT_TOTAL"]
      },
      "align": "center"
    },
    {
      "type": "repeat",
      "count": {
        "bind": "rows"
      },
      "x": 0,
      "y": "MERC_AC_FIRST_ROW_Y + 3",
      "dy": "MERC_AC_ROW_SIZE",
      "template": [
        {
          "type": "text",
          "id": "accountName$i",
          "x": "MERC_AC_FIRST_COLUMN_X + 5",
          "y": 0,
          "width": "MERC_AC_FIRST_COLUMN_WIDTH",
          "font": "MERC_ACCOUNT_DYNAMIC_TEXT_FONT",
          "color": {
            "by": "rows[$i].dead",
            "map": {
              "true": "MERC_ACCOUNT_DEAD_TEXT_COLOR",
              "false": "MERC_ACCOUNT_DYNAMIC_TEXT_COLOR"
            }
          },
          "shadow": "DEFAULT_SHADOW",
          "background": "FONT_MCOLOR_BLACK",
          "text": {
            "bind": "rows[$i].name"
          }
        },
        {
          "type": "text",
          "id": "accountDays$i",
          "x": "MERC_AC_SECOND_COLUMN_X",
          "y": 0,
          "width": "MERC_AC_SECOND_COLUMN_WIDTH",
          "font": "MERC_ACCOUNT_DYNAMIC_TEXT_FONT",
          "color": {
            "by": "rows[$i].dead",
            "map": {
              "true": "MERC_ACCOUNT_DEAD_TEXT_COLOR",
              "false": "MERC_ACCOUNT_DYNAMIC_TEXT_COLOR"
            }
          },
          "shadow": "DEFAULT_SHADOW",
          "background": "FONT_MCOLOR_BLACK",
          "text": {
            "bind": "rows[$i].days"
          },
          "align": "center"
        },
        {
          "type": "text",
          "x": "MERC_AC_THIRD_COLUMN_X",
          "y": 0,
          "width": "MERC_AC_THIRD_COLUMN_WIDTH",
          "font": "MERC_ACCOUNT_DYNAMIC_TEXT_FONT",
          "color": {
            "by": "rows[$i].dead",
            "map": {
              "true": "MERC_ACCOUNT_DEAD_TEXT_COLOR",
              "false": "MERC_ACCOUNT_DYNAMIC_TEXT_COLOR"
            }
          },
          "shadow": "DEFAULT_SHADOW",
          "background": "FONT_MCOLOR_BLACK",
          "text": {
            "bind": "rows[$i].rate"
          },
          "align": "center"
        },
        {
          "type": "text",
          "id": "accountCharge$i",
          "x": "MERC_AC_FOURTH_COLUMN_X",
          "y": 0,
          "width": "MERC_AC_FOURTH_COLUMN_WIDTH",
          "font": "MERC_ACCOUNT_DYNAMIC_TEXT_FONT",
          "color": {
            "by": "rows[$i].dead",
            "map": {
              "true": "MERC_ACCOUNT_DEAD_TEXT_COLOR",
              "false": "MERC_ACCOUNT_DYNAMIC_TEXT_COLOR"
            }
          },
          "shadow": "DEFAULT_SHADOW",
          "background": "FONT_MCOLOR_BLACK",
          "text": {
            "bind": "rows[$i].charge"
          },
          "align": "center"
        }
      ]
    },
    {
      "type": "text",
      "id": "accountTotal",
      "x": "MERC_AC_FOURTH_COLUMN_X",
      "y": "MERC_AC_TOTAL_COST_Y",
      "width": "MERC_AC_FOURTH_COLUMN_WIDTH",
      "font": "MERC_ACCOUNT_DYNAMIC_TEXT_FONT",
      "color": "MERC_ACCOUNT_DYNAMIC_TEXT_COLOR",
      "shadow": "DEFAULT_SHADOW",
      "background": "FONT_MCOLOR_BLACK",
      "text": {
        "bind": "total"
      },
      "align": "center"
    },
    {
      "type": "button",
      "id": "mercAuthorize",
      "x": "MERC_AC_AUTHORIZE_BUTTON_X",
      "y": "MERC_AC_BUTTON_Y",
      "asset": "bigButtons",
      "frames": {
        "offNormal": 0,
        "onNormal": 1
      },
      "priority": "HIGH",
      "cursor": "CURSOR_LAPTOP_SCREEN",
      "primary": "authorize",
      "text": {
        "source": {
          "key": ["MercAccountText", "MERC_ACCOUNT_AUTHORIZE"]
        },
        "font": "FONT12ARIAL",
        "color": "MERC_BUTTON_UP_COLOR",
        "shadow": "DEFAULT_SHADOW",
        "downColor": "MERC_BUTTON_DOWN_COLOR",
        "downShadow": "DEFAULT_SHADOW"
      },
      "enabled": "authorizeEnabled",
      "disabledStyle": "shaded"
    },
    {
      "type": "button",
      "id": "mercAccountHome",
      "x": "MERC_AC_CANCEL_BUTTON_X",
      "y": "MERC_AC_BUTTON_Y",
      "asset": "bigButtons",
      "frames": {
        "offNormal": 0,
        "onNormal": 1
      },
      "priority": "HIGH",
      "cursor": "CURSOR_LAPTOP_SCREEN",
      "primary": "home",
      "text": {
        "source": {
          "key": ["MercAccountText", "MERC_ACCOUNT_HOME"]
        },
        "font": "FONT12ARIAL",
        "color": "MERC_BUTTON_UP_COLOR",
        "shadow": "DEFAULT_SHADOW",
        "downColor": "MERC_BUTTON_DOWN_COLOR",
        "downShadow": "DEFAULT_SHADOW"
      }
    }
