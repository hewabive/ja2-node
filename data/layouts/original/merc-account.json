{
  "@derived": "Jagged Alliance 2 source code (SFI-SCLA) via JA2 Stracciatella",
  "@src": [
    "src/game/Laptop/Mercs_Account.cc EnterMercsAccount (bigbuttons.sti, the authorize button shaded while disabled), RenderMercsAccount (MLG_ORDERGRID, accountnumber.sti, the titles), DisplayHiredMercs (rows of MERC_AC_ROW_SIZE from MERC_AC_FIRST_ROW_Y + 3)"
  ],
  "screen": "mercAccount",
  "frame": "std640",
  "constants": ["Laptop", "Mercs", "Mercs_Account"],
  "assets": {
    "background": {
      "sti": "laptop/mercbackground.sti",
      "stub": {
        "frames": 1,
        "size": ["MERC_BACKGROUND_WIDTH", "MERC_BACKGROUND_HEIGHT"],
        "hollow": true
      }
    },
    "orderGrid": {
      "mlg": "MLG_ORDERGRID",
      "stub": {
        "frames": 1,
        "size": [462, 280],
        "hollow": true
      }
    },
    "accountNumber": {
      "sti": "laptop/accountnumber.sti",
      "stub": {
        "frames": 1,
        "size": [180, 36],
        "hollow": true
      }
    },
    "bigButtons": {
      "sti": "laptop/bigbuttons.sti",
      "stub": {
        "frames": 2,
        "size": [100, 24],
        "states": ["normal", "pressed"]
      }
    }
  },
  "widgets": [
    {
      "type": "tiles",
      "asset": "background",
      "frame": 0,
      "x": "LAPTOP_SCREEN_UL_X",
      "y": "LAPTOP_SCREEN_WEB_UL_Y",
      "columns": 4,
      "rows": 4,
      "dx": "MERC_BACKGROUND_WIDTH",
      "dy": "MERC_BACKGROUND_HEIGHT"
    },
    {
      "type": "image",
      "asset": "orderGrid",
      "frame": 0,
      "x": "MERC_AC_ORDER_GRID_X",
      "y": "MERC_AC_ORDER_GRID_Y"
    },
    {
      "type": "image",
      "asset": "accountNumber",
      "frame": 0,
      "x": "MERC_AC_ACCOUNT_NUMBER_X",
      "y": "MERC_AC_ACCOUNT_NUMBER_Y"
    },
    {
      "type": "text",
      "id": "mercAccountNumber",
      "x": "MERC_AC_ACCOUNT_NUMBER_TEXT_X",
      "y": "MERC_AC_ACCOUNT_NUMBER_TEXT_Y",
      "font": "MERC_ACCOUNT_TEXT_FONT",
      "color": "MERC_ACCOUNT_TEXT_COLOR",
      "shadow": "DEFAULT_SHADOW",
      "background": "FONT_MCOLOR_BLACK",
      "text": {
        "bind": "accountNumber"
      }
    },
    {
      "type": "text",
      "x": "MERC_AC_FIRST_COLUMN_X",
      "y": "MERC_AC_MERC_TITLE_Y",
      "width": "MERC_AC_FIRST_COLUMN_WIDTH",
      "font": "MERC_ACCOUNT_TEXT_FONT",
      "color": "MERC_ACCOUNT_TEXT_COLOR",
      "shadow": "DEFAULT_SHADOW",
      "background": "FONT_MCOLOR_BLACK",
      "text": {
        "key": ["MercAccountText", "MERC_ACCOUNT_MERC"]
      },
      "align": "center"
    },
    {
      "type": "text",
      "x": "MERC_AC_SECOND_COLUMN_X",
      "y": "MERC_AC_MERC_TITLE_Y",
      "width": "MERC_AC_SECOND_COLUMN_WIDTH",
      "font": "MERC_ACCOUNT_TEXT_FONT",
      "color": "MERC_ACCOUNT_TEXT_COLOR",
      "shadow": "DEFAULT_SHADOW",
      "background": "FONT_MCOLOR_BLACK",
      "text": {
        "key": ["MercAccountText", "MERC_ACCOUNT_DAYS"]
      },
      "align": "center"
    },
    {
      "type": "text",
      "x": "MERC_AC_THIRD_COLUMN_X",
      "y": "MERC_AC_MERC_TITLE_Y",
      "width": "MERC_AC_THIRD_COLUMN_WIDTH",
      "font": "MERC_ACCOUNT_TEXT_FONT",
      "color": "MERC_ACCOUNT_TEXT_COLOR",
      "shadow": "DEFAULT_SHADOW",
      "background": "FONT_MCOLOR_BLACK",
      "text": {
        "key": ["MercAccountText", "MERC_ACCOUNT_RATE"]
      },
      "align": "center"
    },
    {
      "type": "text",
      "x": "MERC_AC_FOURTH_COLUMN_X",
      "y": "MERC_AC_MERC_TITLE_Y",
      "width": "MERC_AC_FOURTH_COLUMN_WIDTH",
      "font": "MERC_ACCOUNT_TEXT_FONT",
      "color": "MERC_ACCOUNT_TEXT_COLOR",
      "shadow": "DEFAULT_SHADOW",
      "background": "FONT_MCOLOR_BLACK",
      "text": {
        "key": ["MercAccountText", "MERC_ACCOUNT_CHARGE"]
