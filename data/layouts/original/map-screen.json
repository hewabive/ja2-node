  "@derived": "Jagged Alliance 2 source code (SFI-SCLA) via JA2 Stracciatella",
  "@src": [
    "src/game/Strategic/MapScreen.cc MapScreenHandle (the regions of the map view at MSYS_PRIORITY_HIGH - 3, the character info hand at PLAYER_INFO_HAND_*, the face at PLAYER_INFO_FACE_*, the low screen mask with CURSOR_NORMAL; contractbutton.sti 0/1 at CONTRACT_X + 5, CONTRACT_Y - 1 with pContractButtonString in MAP_SCREEN_FONT, colour CHAR_TEXT_FONT_COLOR, hilite FONT_MCOLOR_WHITE), AddTeamPanelSortButtonsForMapScreen (the MLG goldpiecebuttons.sti images {0, 1, 5, 2, 3, 4} and + 6 at gMapSortButtons, MSYS_PRIORITY_HIGHEST - 5, wMapScreenSortButtonHelpText), RenderCharacterInfoBackground (charinfo.sti at TOWN_INFO_X, TOWN_INFO_Y), RenderTeamRegionBackground (newgoldpiece3.sti at PLAYER_INFO_X, PLAYER_INFO_Y), RenderAttributeStringsForUpperLeftHandCorner, CreateDestroyMapCharacterScrollButtons (map_screen_bottom_arrows.sti 11/4/6 and 12/5/7 at 67, 69 and 67, 87, pMapScreenPrevNextCharButtonHelpText), GetMapKeyboardInput (HandleModNone, HandleModShift, HandleModCtrl, HandleModAlt)",
    "src/game/Strategic/Map_Screen_Interface_Border.cc RenderMapBorder (mbs.sti at MAP_BORDER_X, MAP_BORDER_Y), CreateButtonsForMapBorder (map_border_buttons.sti g / g + 9 at BTN_*_X, STD_SCREEN_Y + 323, MSYS_PRIORITY_HIGH, pMapScreenBorderButtonHelpText), DisplayCurrentLevelMarker (greenarr.sti at MAP_LEVEL_MARKER_X, MAP_LEVEL_MARKER_Y + MAP_LEVEL_MARKER_DELTA * z), CreateMouseRegionsForLevelMarkers (zMarksMapScreenText[0] and the level), RenderMapBorderEtaPopUp (eta_pop_up.sti at MAP_BORDER_X + 215, STD_SCREEN_Y + 291)",
    "src/game/Strategic/Map_Screen_Interface_Bottom.cc RenderMapScreenInterfaceBottom (map_screen_bottom.sti at MAP_BOTTOM_X, MAP_BOTTOM_Y), CreateButtonsForMapScreenInterfaceBottom (map_border_buttons.sti 6/15, 7/16 and 18/19 at 456, 410, 496, 410 and 458, 372 with MSYS_PRIORITY_HIGHEST - 1; map_screen_bottom_arrows.sti 10/1/3, 9/0/2, 11/4/6 and 12/5/7 at 528, 456, 466, 456, 331, 371 and 331, 452 with MSYS_PRIORITY_HIGHEST - 2; pMapScreenBottomFastHelp), CreateCompressModePause (487, 456 to 522, 467 at MSYS_PRIORITY_HIGH, pMapScreenBottomFastHelp[7]), CreateMapScreenBottomMessageScrollBarRegion, DisplayCurrentBalanceTitleForMapBottom, DisplayCurrentBalanceForMapBottom, DisplayProjectedDailyMineIncome (COMPFONT, MAP_BOTTOM_FONT_COLOR and 183, centred in 437 - 359 by 10), DrawNameOfLoadedSector (COMPFONT 183 centred in 80 by 16 at 548, 426), CreateDestroyMouseRegionMasksForTimeCompressionButtons",
    "src/game/Strategic/Game_Clock.cc RenderClock (COMPFONT, FONT_LTGREEN or FONT_FCOLOR_NICERED in combat, centred in CLOCK_WIDTH by CLOCK_HEIGHT), CreateMouseRegionForPauseOfClock; src/game/UILayout.cc get_CLOCK_X (STD_SCREEN_X + 554 on the map), get_CLOCK_Y, get_RADAR_WINDOW_X (STD_SCREEN_X + 543), get_RADAR_WINDOW_TM_Y",
    "src/game/Strategic/Map_Screen_Interface_Map.cc LoadMapScreenInterfaceMapGraphics (b_map.pcx, mine_1/2/3.sti, boxes.sti, mapcursr.sti, merc_between_sector_icons.sti, merc_mvt_green_arrows.sti, helicop.sti, hilite.sti, sam.sti, mine.sti, militia.sti, bullseye.sti, the secret site icons)",
    "src/game/Strategic/Map_Screen_Interface.cc CreateDestroyAssignmentPopUpBoxes and the PopUpBox margins of the assignment family (6, 6, 4, 4, line space 2), CreateTownInfoBox (margins 6, 6, 8 + BOX_BUTTON_HEIGHT, 6), CreateDestroyMovementBox (the move box at 450, 100)"
