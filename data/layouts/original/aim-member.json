{
  "@derived": "Jagged Alliance 2 source code (SFI-SCLA) via JA2 Stracciatella",
  "@src": [
    "src/game/Laptop/AIMMembers.cc EnterAIMMembers (the face region over the portrait, the shut-up region over the web area at MSYS_PRIORITY_HIGH - 1, the Previous, Contact and Next buttons on bottombuttons2.sti in AIM_M_FONT_PREV_NEXT_CONTACT), RenderAIMMembers, UpdateMercInfo, DisplayMercsInventory, DisplayMercsFace (the overlay at FACE_X + 1, FACE_Y + 107 in FONT14ARIAL colour 145), DisplayMercStats, DisplayAimMemberClickOnFaceHelpText",
    "src/game/Laptop/AIMMembers.cc DisplayVideoConferencingDisplay, DisplayMercsVideoFace, DisplayMercChargeAmount (the amount at AIM_CONTRACT_CHARGE_AMOUNNT_X + 1, Y + 3), InitDeleteVideoConferencePopUp and MakeButtonVideo (videoconfbuttons.sti 0/1 and 2/3 in FONT12ARIAL, the contract and kit buttons left-justified AIM_MEMBER_BUY_EQUIPMENT_GAP apart, the others AIM_MEMBER_AUTHORIZE_PAY_GAP apart; x_button.sti at AIM_MEMBER_VIDEO_CONF_XCLOSE_X), DrawButtonSelection, CreateAimPopUpBox (videoconfpopup.sti, the OK button at +20, +62 with priority MSYS_PRIORITY_HIGH + 5), DisplayAimPopUpBox, the subtitle box (BASIC_MERC_POPUP, 300 wide, at TEXT_POPUP_WINDOW_Y)"
  ],
  "screen": "aimMember",
  "frame": "std640",
  "constants": ["Laptop", "AIM", "AIMMembers", "AIMFacialIndex", "MercTextBox"],
