{
  "name": "ja2-node",
  "version": "0.7.0",
  "private": true,
  "description": "Non-commercial web reimplementation of Jagged Alliance 2: Node server, browser client",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "node tools/dev.ts",
    "server": "node src/server/main.ts",
    "web": "vite",
    "build": "vite build",
    "stubs": "node stubs/build.ts",
    "cli": "node tools/cli.ts",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "imports": "node tools/check-imports.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:data": "vitest related tests/support/original-data.ts --run",
    "test:reload": "JA2_RELOAD=1 vitest related tests/support/reload.ts --run",
    "e2e": "playwright test",
    "e2e:data": "playwright test -c playwright.data.config.ts",
    "e2e:browsers": "playwright test -c playwright.browsers.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm imports && pnpm test",
    "gates": "node tools/gates.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "ws": "8.22.0",
    "zod": "4.6.7"
  }
}
