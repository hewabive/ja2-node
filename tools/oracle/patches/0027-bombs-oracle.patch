+UINT32 OracleExplosionSlotCount()
+{
+	return NUM_EXPLOSION_SLOTS;
+}
+
+EXPLOSIONTYPE const* OracleExplosionSlot(UINT32 const i)
+{
+	return &gExplosionData[i];
+}
+
+BOOLEAN OracleExplosionQueueEntry(UINT8 const i, UINT32* const bomb, UINT32* const timestamp)
+{
+	ExplosionQueueElement const& e = gExplosionQueue[i];
+	*bomb      = e.uiWorldBombIndex;
+	*timestamp = e.uiTimeStamp;
+	return e.fExists;
+}
+
+BOOLEAN OracleExplosionQueueMayHaveChangedSight()
+{
+	return gfExplosionQueueMayHaveChangedSight;
+}
+
+SOLDIERTYPE* OraclePersonToSetOffExplosions()
+{
+	return gPersonToSetOffExplosions;
+}
+
+void OracleResetExplosions()
+{
+	FOR_EACH(EXPLOSIONTYPE, e, gExplosionData)
+	{
+		if (e->fAllocated) RemoveExplosionData(e);
+	}
+	FOR_EACH(ExplosionQueueElement, e, gExplosionQueue)
+	{
+		*e = ExplosionQueueElement{};
+	}
+	gubElementsOnExplosionQueue         = 0;
+	gfExplosionQueueActive              = FALSE;
+	gfExplosionQueueMayHaveChangedSight = FALSE;
+	gPersonToSetOffExplosions           = 0;
+}
