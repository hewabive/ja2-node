+
+UINT16 OracleFindRefusalReason(SOLDIERTYPE const* const s)
+{
+	return FindRefusalReason(s);
+}
+
+
+BOOLEAN OracleContractIsExpiring(SOLDIERTYPE* const s)
+{
+	return ContractIsExpiring(s);
+}
+
+
+BOOLEAN OracleContractIsGoingToExpireSoon(SOLDIERTYPE* const s)
+{
+	return ContractIsGoingToExpireSoon(s);
+}
+
+
+UINT8 OracleContractRenewalCount()
+{
+	return ubNumContractRenewals;
+}
+
+
+UINT8 OracleContractRenewalProfile(UINT8 const i)
+{
+	return ContractRenewalList[i].ubProfileID;
+}
+
+
+UINT8 OracleCurrentContractRenewal()
+{
+	return ubCurrentContractRenewal;
+}
+
+
+UINT8 OracleContractRenewalInProgress()
+{
+	return ubCurrentContractRenewalInProgress;
+}
+
+
+void OracleSetContractRenewals(std::vector<UINT8> const& profiles)
+{
+	ubNumContractRenewals = 0;
+	for (UINT8 const pid : profiles) ContractRenewalList[ubNumContractRenewals++].ubProfileID = pid;
+}
+
+
+void OracleResetContractRenewalSequence()
+{
+	ubCurrentContractRenewal           = 0;
+	ubCurrentContractRenewalInProgress = FALSE;
+	gfContractRenewalSquenceOn         = FALSE;
+	gfInContractMenuFromRenewSequence  = FALSE;
+}
