+INT32 OracleLeaveListItems(UINT32 const slot, std::vector<OBJECTTYPE>* const items)
+{
+	if (!gpLeaveListHead[slot]) return -1;
+	INT32 n = 0;
+	for (MERC_LEAVE_ITEM const* i = gpLeaveListHead[slot]; i; i = i->pNext, ++n)
+	{
+		if (items) items->push_back(i->o);
+	}
+	return n;
+}
