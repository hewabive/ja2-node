+
+static SOLDIERTYPE gOracleSkiProbeMerc;
+
+struct OracleSkiSelection
+{
+	ArmsDealerID dealer;
+	SOLDIERTYPE* merc;
+
+	OracleSkiSelection(ArmsDealerID const d, UINT8 const profile) : dealer(gbSelectedArmsDealerID), merc(gpSMCurrentMerc)
+	{
+		gOracleSkiProbeMerc.ubProfile = profile;
+		gbSelectedArmsDealerID = d;
+		gpSMCurrentMerc = &gOracleSkiProbeMerc;
+	}
+
+	~OracleSkiSelection()
+	{
+		gbSelectedArmsDealerID = dealer;
+		gpSMCurrentMerc = merc;
+	}
+};
+
+
+UINT32 OracleCalcShopKeeperItemPrice(ArmsDealerID const dealer, UINT8 const mercProfile, BOOLEAN const fDealerSelling, BOOLEAN const fUnitPriceOnly, FLOAT const dModifier, const OBJECTTYPE* const pItemObject)
+{
+	OracleSkiSelection const selection(dealer, mercProfile);
+	return CalcShopKeeperItemPrice(fDealerSelling, fUnitPriceOnly, pItemObject->usItem, dModifier, pItemObject);
+}
+
+
+FLOAT OracleItemConditionModifier(UINT16 const usItemIndex, INT8 const bStatus)
+{
+	return ItemConditionModifier(usItemIndex, bStatus);
+}
+
+
+UINT32 OracleEvaluateInvSlot(ArmsDealerID const dealer, UINT8 const mercProfile, const OBJECTTYPE* const pItemObject, UINT32* const puiPrice)
+{
+	OracleSkiSelection const selection(dealer, mercProfile);
+	INVENTORY_IN_SLOT slot{};
+	slot.fActive = TRUE;
+	slot.sItemIndex = pItemObject->usItem;
+	slot.ItemObject = *pItemObject;
+	slot.ubIdOfMercWhoOwnsTheItem = mercProfile;
+	slot.bSlotIdInOtherLocation = -1;
+	UINT32 const result = EvaluateInvSlot(&slot);
+	*puiPrice = slot.uiItemPrice;
+	return result;
+}
+
+
+BOOLEAN OracleHandlePossibleRepairDelays(ArmsDealerID const dealer)
+{
+	OracleSkiSelection const selection(dealer, NO_PROFILE);
+	HandlePossibleRepairDelays();
+	BOOLEAN const delayed = gfStartWithRepairsDelayedQuote;
+	gfStartWithRepairsDelayedQuote = FALSE;
+	return delayed;
+}
+
+
+static OracleSkiBox OracleBoxOf(INVENTORY_IN_SLOT const& slot, UINT32 const unitPrice)
+{
+	OracleSkiBox box{};
+	box.item = slot.sItemIndex;
+	box.element = slot.sSpecialItemElement;
+	box.count = slot.ItemObject.ubNumberOfObjects;
+	box.flags = slot.uiFlags;
+	box.unitPrice = unitPrice;
+	box.owner = slot.ubIdOfMercWhoOwnsTheItem;
+	box.object = slot.ItemObject;
+	return box;
+}
+
+
+void OracleInitializeShopKeeper(ArmsDealerID const dealer, UINT8 const mercProfile, std::vector<OracleSkiBox>* const boxes, std::vector<OracleSkiBox>* const offered)
+{
+	OracleSkiSelection const selection(dealer, mercProfile);
+	std::fill_n(PlayersOfferArea, SKI_NUM_TRADING_INV_SLOTS, INVENTORY_IN_SLOT{});
+	gArmsDealerStatus[dealer].uiTimePlayerLastInSKI = GetWorldTotalMin();
+	gSelectArmsDealerInfo.uiNumDistinctInventoryItems = CountDistinctItemsInArmsDealersInventory(dealer);
+	guiNextFreeInvSlot = 0;
+	if (gSelectArmsDealerInfo.uiNumDistinctInventoryItems > 0) DetermineArmsDealersSellingInventory();
+	bool const repairs = DoesDealerDoRepairs(dealer);
+	for (UINT32 i = 0; i < guiNextFreeInvSlot; ++i)
+	{
+		INVENTORY_IN_SLOT const& slot = gpTempDealersInventory[i];
+		UINT32 const price = repairs ? 0 : CalcShopKeeperItemPrice(DEALER_SELLING, TRUE, slot.sItemIndex, SelectedArmsDealer()->sellingPrice, &slot.ItemObject);
+		boxes->push_back(OracleBoxOf(slot, price));
+	}
+	for (INVENTORY_IN_SLOT const& slot : PlayersOfferArea)
+	{
+		if (slot.fActive) offered->push_back(OracleBoxOf(slot, 0));
+	}
+	delete[] gpTempDealersInventory;
+	gpTempDealersInventory = NULL;
+	guiNextFreeInvSlot = 0;
+	std::fill_n(PlayersOfferArea, SKI_NUM_TRADING_INV_SLOTS, INVENTORY_IN_SLOT{});
+}
