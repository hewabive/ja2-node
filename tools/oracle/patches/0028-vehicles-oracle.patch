 /*
  * Smell & Blood system
@@ -457,7 +461,9 @@
 		INT8 const strength = BLOOD_FLOOR_STRENGTH(me.ubBloodInfo);
 		if (strength == 0) return;
 
+		OracleTraceMark(ORACLE_MARK_COSMETIC_BEGIN);
 		UINT16 const index     = Random(4) * 4 + 3 - strength / 2U;
+		OracleTraceMark(ORACLE_MARK_COSMETIC_END);
 		UINT32 const type      =
 			BLOOD_FLOOR_TYPE(me.ubSmellInfo) == HUMAN ? HUMANBLOOD :
 			CREATUREBLOOD;
--- a/src/game/Tactical/Turn_Based_Input.cc
