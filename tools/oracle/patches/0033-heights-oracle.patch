 }
+
+UINT32 OracleFlyingBulletCount()
+{
+	UINT32 count = 0;
+	for (BULLET const& b : gBullets)
+	{
+		if (b.fAllocated && !b.fToDelete && !(b.usFlags & BULLET_STOPPED)) ++count;
+	}
+	return count;
+}
