+void OracleSimulateObjects()
+{
+	for (UINT32 i = 0; i < guiNumObjectSlots; ++i)
+	{
+		if (ObjectSlots[i].fAllocated) SimulateObject(&ObjectSlots[i]);
+	}
+}
+
+UINT32 OracleLiveObjectCount()
+{
+	UINT32 count = 0;
+	for (UINT32 i = 0; i < guiNumObjectSlots; ++i)
+	{
+		if (ObjectSlots[i].fAllocated) ++count;
+	}
+	return count;
+}
