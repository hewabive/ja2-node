+INT32 OracleSettleMercAccounts(UINT8 const ubCurMercIndex)
+{
+	giMercTotalContractCharge = 0;
+	for (const MERCListingModel* m : GCM->getMERCListings())
+	{
+		ProfileID         const  pid = GetProfileIDFromMERCListing(m);
+		MERCPROFILESTRUCT const& p   = GetProfile(pid);
+		if (IsMercOnTeam(pid) || p.iMercMercContractLength != 0)
+		{
+			giMercTotalContractCharge += p.sSalary * p.iMercMercContractLength;
+		}
+	}
+	gubCurMercIndex = ubCurMercIndex;
+	SettleMercAccounts();
+	return giMercTotalContractCharge;
+}
