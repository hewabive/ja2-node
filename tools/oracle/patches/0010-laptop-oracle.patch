+UINT16 OracleAimHireDecision(ProfileID const pid, BOOLEAN* const accepted)
+{
+	gbCurrentSoldier = pid;
+	gOracleAimHeadless = true;
+	gOracleAimQuote = QUOTE_NONE;
+	*accepted = CanMercBeHired();
+	gOracleAimHeadless = false;
+	return gOracleAimQuote;
+}
+
+
+INT8 OracleAimMemberHireMerc(ProfileID const pid, UINT8 const contractLength, BOOLEAN const gear, INT32* const amount)
+{
+	gbCurrentSoldier = pid;
+	gubContractLength = contractLength;
+	gfBuyEquipment = gear;
+	giContractAmount = CalcMercContractAmount(GetProfile(pid));
+	*amount = giContractAmount;
+	if (LaptopSaveInfo.iCurrentBalance < giContractAmount) return -2;
+	gOracleAimHeadless = true;
+	gOracleAimProfile = pid;
+	INT8 const ret = AimMemberHireMerc();
+	gOracleAimHeadless = false;
+	return ret;
+}
