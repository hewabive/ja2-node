+UINT8 OracleNPCConsiderReceivingItemFromMerc(UINT8 const npc, UINT8 const merc, OBJECTTYPE const* const o, INT32* const index, INT32* const record)
+{
+	NPCQuoteInfo* const quotes = EnsureQuoteFileLoaded(npc);
+	if (!quotes)
+	{
+		*index = -2;
+		*record = -2;
+		return 0;
+	}
+	NPCQuoteInfo* found = 0;
+	UINT8 number = 0;
+	UINT8 const opinion = NPCConsiderReceivingItemFromMerc(npc, merc, o, quotes, &found, &number);
+	*index = found ? number : -1;
+	*record = found ? static_cast<INT32>(found - quotes) : -1;
+	return opinion;
+}
