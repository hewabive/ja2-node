+}
+
+NPCQuoteInfo const* OracleQuoteArray(UINT8 const npc, bool const backup)
+{
+	return backup ? gpBackupNPCQuoteInfoArray[npc] : gpNPCQuoteInfoArray[npc];
+}
+
+NPCQuoteInfo const* OracleCivQuoteArray(UINT8 const index)
+{
