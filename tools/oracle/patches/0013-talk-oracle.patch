+UINT8 OracleNPCConsiderTalking(UINT8 const npc, UINT8 const merc, Approach const approach, UINT8 const record, INT32* const index)
+{
+	NPCQuoteInfo* const quotes = EnsureQuoteFileLoaded(npc);
+	if (!quotes)
+	{
+		*index = -2;
+		return 0;
+	}
+	NPCQuoteInfo* found = 0;
+	UINT8 number = 0;
+	UINT8 const opinion = NPCConsiderTalking(npc, merc, approach, record, quotes, &found, &number);
+	*index = found ? number : -1;
+	return opinion;
+}
+
