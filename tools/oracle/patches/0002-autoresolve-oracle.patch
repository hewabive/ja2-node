+bool OracleAutoResolveCanBandage(void)
+{
+	return gpAR->ubBattleStatus == BATTLE_VICTORY && gpAR->ubAliveMercs && IsAnybodyWounded() && CanAnybodyBandage() && FindMedicalKit();
+}
