+static void OracleCellPosition(SOLDIERCELL const* const c, INT32 position[2])
+{
+	position[0] = -1;
+	position[1] = -1;
+	if (!c) return;
+	if (c >= gpMercs && c < gpMercs + 20)
+	{
+		position[0] = 0;
+		position[1] = static_cast<INT32>(c - gpMercs);
+	}
+	else if (c >= gpCivs && c < gpCivs + MAX_ALLOWABLE_MILITIA_PER_SECTOR)
+	{
+		position[0] = 1;
+		position[1] = static_cast<INT32>(c - gpCivs);
+	}
+	else if (c >= gpEnemies && c < gpEnemies + 32)
+	{
+		position[0] = 2;
+		position[1] = static_cast<INT32>(c - gpEnemies);
+	}
+}
+
+
+bool OracleAutoResolveInfo(OracleARInfo& info)
+{
+	if (!gpAR) return false;
+	AUTORESOLVE_STRUCT const& ar = *gpAR;
+	info.status = ar.ubBattleStatus;
+	info.elapsedMs = ar.uiTotalElapsedBattleTimeInMilliseconds;
+	info.playerAttack = ar.usPlayerAttack;
+	info.playerDefence = ar.usPlayerDefence;
+	info.enemyAttack = ar.usEnemyAttack;
+	info.enemyDefence = ar.usEnemyDefence;
+	info.playerLeadership = ar.ubPlayerLeadership;
+	info.enemyLeadership = ar.ubEnemyLeadership;
+	info.mercs = ar.ubMercs;
+	info.civs = ar.ubCivs;
+	info.enemies = ar.ubEnemies;
+	info.aliveMercs = ar.ubAliveMercs;
+	info.aliveCivs = ar.ubAliveCivs;
+	info.aliveEnemies = ar.ubAliveEnemies;
+	info.admins = ar.ubAdmins;
+	info.troops = ar.ubTroops;
+	info.elites = ar.ubElites;
+	info.playerDefenceAdvantage = ar.ubPlayerDefenceAdvantage;
+	info.pendingSurrender = ar.fPendingSurrender;
+	info.rejectedSurrender = ar.fPlayerRejectedSurrenderOffer;
+	info.captureNotPermittedDueToEPCs = ar.fCaptureNotPermittedDueToEPCs;
+	info.moraleEventsHandled = ar.fMoraleEventsHandled;
+	info.robotCell = ar.pRobotCell ? static_cast<INT32>(ar.pRobotCell - gpMercs) : -1;
+	info.robotController = -1;
+	if (ar.pRobotCell && ar.pRobotCell->pSoldier->robot_remote_holder)
+	{
+		for (INT32 i = 0; i != ar.ubMercs; ++i)
+		{
+			if (gpMercs[i].pSoldier == ar.pRobotCell->pSoldier->robot_remote_holder) info.robotController = i;
+		}
+	}
+	info.slices = gOracleARSlices;
+	return true;
+}
+
+
+bool OracleAutoResolveCell(int const side, int const index, OracleARCellInfo& out)
+{
+	if (!gpAR || index < 0) return false;
+	SOLDIERCELL const* c = nullptr;
+	if (side == 0 && index < gpAR->ubMercs) c = &gpMercs[index];
+	if (side == 1 && index < gpAR->ubCivs) c = &gpCivs[index];
+	if (side == 2 && index < gpAR->ubEnemies) c = &gpEnemies[index];
+	if (!c || !c->pSoldier) return false;
+	out.soldier = c->pSoldier;
+	out.flags = c->uiFlags;
+	out.attack = c->usAttack;
+	out.defence = c->usDefence;
+	out.nextAttack = c->usNextAttack;
+	for (int j = 0; j != 3; ++j)
+	{
+		out.nextHit[j] = c->usNextHit[j];
+		out.hitDamage[j] = c->usHitDamage[j];
+		OracleCellPosition(c->pAttacker[j], out.attacker[j]);
+	}
+	out.weaponSlot = c->bWeaponSlot;
+	return true;
+}
