+static constexpr UINT32 ORACLE_AR_MAX_FRAMES = 10000000;
+
+void OracleAutoResolveEnter(const SGPSector& ubSector)
+{
+	gubCreatureBattleCode = CREATURE_BATTLE_CODE_NONE;
+	gpAR = new AUTORESOLVE_STRUCT{};
+	gpMercs = gpAR->mercs.data();
+	gpCivs = gpAR->civs.data();
+	gpEnemies = gpAR->enemies.data();
+	gpAR->fEnteringAutoResolve = FALSE;
+	gpAR->ubSector = ubSector;
+	gpAR->ubBattleStatus = BATTLE_IN_PROGRESS;
+	gpAR->uiTimeSlice = 1000;
+	gpAR->uiTotalElapsedBattleTimeInMilliseconds = 0;
+	gpAR->fSound = TRUE;
+	gpAR->fMoraleEventsHandled = FALSE;
+	gpAR->uiPreRandomIndex = guiPreRandomIndex;
+	switch( gubEnemyEncounterCode )
+	{
+		case ENEMY_ENCOUNTER_CODE:
+			gpAR->ubPlayerDefenceAdvantage = 21;
+			break;
+		case ENEMY_INVASION_CODE:
+		case CREATURE_ATTACK_CODE:
+		default:
+			gpAR->ubPlayerDefenceAdvantage = 0;
+			break;
+	}
+	gOracleARSlices = 0;
+	gOracleARMidSlice = FALSE;
+	gOracleARSliceBudget = -1;
+	KillPreBattleInterface();
+	CalculateAutoResolveInfo();
+	CalculateSoldierCells();
+	CreateAutoResolveInterface();
+	DetermineTeamLeader( TRUE );
+	DetermineTeamLeader( FALSE );
+}
+
+
+void OracleAutoResolveRate(void)
+{
+	CalculateAttackValues();
+	gpAR->fRenderAutoResolve = TRUE;
+	gpAR->uiTimeSlice = 0xffffffff;
+	gpAR->fSound = FALSE;
+	if (!gpAR->uiCurrTime) gpAR->uiCurrTime = std::max<UINT32>(GetJA2Clock(), 1);
+}
+
+
+UINT32 OracleAutoResolveRun(UINT32 const sliceBudget)
+{
+	gOracleARSliceBudget = static_cast<INT32>(std::min<UINT32>(sliceBudget, 0x7fffffff));
+	for (UINT32 frame = 0; frame != ORACLE_AR_MAX_FRAMES; ++frame)
+	{
+		if (gpAR->ubBattleStatus != BATTLE_IN_PROGRESS || gpAR->fPendingSurrender) break;
+		if (gOracleARSlices >= sliceBudget && !gOracleARMidSlice) break;
+		ProcessBattleFrame();
+	}
+	gOracleARSliceBudget = -1;
+	return gOracleARSlices;
+}
+
+
+void OracleAutoResolveRetreat(INT32 const mercCell)
+{
+	if (mercCell < 0)
+	{
+		RetreatButtonCallback(nullptr, MSYS_CALLBACK_REASON_POINTER_UP);
+		return;
+	}
+	if( gpAR->fPendingSurrender ) return;
+	if (mercCell >= gpAR->ubMercs) return;
+	SOLDIERCELL * const pCell = &gpMercs[ mercCell ];
+	if( pCell->uiFlags & ( CELL_RETREATING | CELL_RETREATED ) ) return;
+	if( pCell == gpAR->pRobotCell ) return;
+	pCell->uiFlags |= CELL_RETREATING | CELL_DIRTY;
+	pCell->usNextAttack = (UINT16)((1000 + pCell->usNextAttack * 5 + PreRandom( 2000 - pCell->usAttack ))*2);
+	gpAR->usPlayerAttack -= pCell->usAttack;
+	pCell->usAttack = 0;
+	if( gpAR->pRobotCell )
+	{
+		const SOLDIERTYPE* const robot_controller = gpAR->pRobotCell->pSoldier->robot_remote_holder;
+		if (robot_controller == NULL)
+		{
+			gpAR->pRobotCell->uiFlags &= ~CELL_RETREATING;
+			gpAR->pRobotCell->uiFlags |= CELL_DIRTY;
+			gpAR->pRobotCell->usNextAttack = 0xffff;
+		}
+		else if (robot_controller == pCell->pSoldier)
+		{
+			gpAR->pRobotCell->uiFlags |= CELL_RETREATING | CELL_DIRTY;
+			gpAR->pRobotCell->usNextAttack = pCell->usNextAttack;
+			gpAR->usPlayerAttack -= gpAR->pRobotCell->usAttack;
+			gpAR->pRobotCell->usAttack = 0;
+		}
+	}
+}
+
+
+void OracleAutoResolveSurrender(bool const accept)
+{
+	if (!gpAR->fPendingSurrender) return;
+	if (accept) AcceptSurrenderCallback(nullptr, MSYS_CALLBACK_REASON_POINTER_UP);
+	else RejectSurrenderCallback(nullptr, MSYS_CALLBACK_REASON_POINTER_UP);
+}
+
+
+void OracleAutoResolveBattleEnd(void)
+{
+	if (gpAR->ubBattleStatus == BATTLE_IN_PROGRESS) return;
+	HandleAutoResolveBattleEnd(SGPSector(gpAR->ubSector.x, gpAR->ubSector.y, 0));
+}
+
