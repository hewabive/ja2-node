+extern std::optional<EDTFile> gFloristGalleryTexts;
+
+void OracleFlowerOrder(UINT32 const flower, UINT8 const location, BOOLEAN const next_day, BOOLEAN const crushed, BOOLEAN const black_roses, BOOLEAN const wilted, BOOLEAN const fruit_cake)
+{
+	if (!gFloristGalleryTexts) gFloristGalleryTexts = EDTFile(EDTFile::FLORIST_DESCRIPTIONS);
+	guiCurrentlySelectedFlower         = flower;
+	gubCurrentlySelectedFlowerLocation = location;
+	gfFLoristCheckBox0Down             = next_day;
+	gfFLoristCheckBox1Down             = !next_day;
+	gfFLoristCheckBox2Down             = crushed;
+	gfFLoristCheckBox3Down             = black_roses;
+	gfFLoristCheckBox4Down             = wilted;
+	gfFLoristCheckBox5Down             = fruit_cake;
+}
+
+void OracleFlowerOrderFormEntered()
+{
+	AdvanceFlowerOrderNumberOnEntry();
+}
+
+UINT32 OracleFlowerOrderPrice()
+{
+	return CalcFlowerOrderPrice();
+}
+
+void OracleFlowerOrderSend()
+{
+	guiFlowerPrice = CalcFlowerOrderPrice();
+	SendFlowerOrder();
+}
