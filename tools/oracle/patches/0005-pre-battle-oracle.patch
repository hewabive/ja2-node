+void OracleDeterminePersistentEncounterCode(GROUP* const battle_group, SGPSector const& sector)
+{
+	gfPersistantPBI = TRUE;
+	gpBattleGroup   = battle_group;
+	gubPBSector     = sector;
+	gfPreBattleInterfaceActive = TRUE;
+	WakeUpAllMercsInSectorUnderAttack();
+	DeterminePersistentEncounterCode(battle_group, sector, 0);
+	gfHighPotentialForAmbush = FALSE;
+	gfPreBattleInterfaceActive = FALSE;
+}
