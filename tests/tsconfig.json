{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "rootDir": "..",
    "outDir": "../.cache/tsc/tests",
    "tsBuildInfoFile": "../.cache/tsc/tests.tsbuildinfo"
  },
  "include": [
    "**/*.ts",
    "../src/**/*.test.ts",
    "../stubs/**/*.test.ts",
