    },
    {
      "path": "../src/node"
    },
    {
      "path": "../src/server"
    },
    {
      "path": "../src/render"
    },
    {
      "path": "../src/audio"
    },
    {
      "path": "../src/app"
    },
    {
      "path": "../src/devtools"
    },
    {
      "path": "../stubs"
    },
    {
      "path": "../tools"
    }
  ]
